{
  "routes": [
    {
      "src": "/",
      "dest": "/api/shop-page"
    },
    {
      "src": "/llms.txt",
      "dest": "/api/llms"
    },
    {
      "src": "/ai-booking",
      "dest": "/api/ai-booking"
    },
    {
      "src": "/api/receptionist/chat",
      "dest": "/api/receptionist-chat"
    },
    {
      "src": "/api/receptionist/whatsapp",
      "dest": "/api/receptionist-whatsapp"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
